{
  "name": "W205 Dev Env (Simple)",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "w205",
  "workspaceFolder": "/workspaces/w205",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/w205,type=bind,consistency=cached",
  "features": {
    "ghcr.io/devcontainers/features/linux-user:1": {
      "username": "w205",
      "uid": "1001",
      "gid": "1001"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": true,
      "username": "w205"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.fontFamily": "MesloLGS NF",
        "workbench.startupEditor": "none",
        "files.eol": "\n"
      }
    }
  },
  "runArgs": [
    "--network=anaconda_postgres_default"
  ],
  "shutdownAction": "stopContainer"
}